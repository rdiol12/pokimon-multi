@@ -993,6 +999,15 @@ uint16_t GBAIORead(struct GBA* gba, uint32_t address) {
 		}
 		// Fall through
 	default:
+		if (address == GBA_REG_PKX_ID) {
+			return GBA_PKX_ID;
+		}
+		if (address == GBA_REG_PKX_VERSION) {
+			return GBA_PKX_VERSION;
+		}
+		if (address == GBA_REG_PKX_CONTROL) {
+			return GBAPKXReadControl(gba);
