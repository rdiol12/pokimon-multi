+	case GBA_REG_PKX_CONTROL:
+		GBAPKXWriteControl(gba, value);
+		return;
+	case GBA_REG_PKX_ID:
+	case GBA_REG_PKX_VERSION:
+		return;
 	case GBA_REG_DEBUG_FLAGS:
 		if (gba->debug) {
