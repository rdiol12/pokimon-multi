+void GBAPKXSetExtendedEWRAM(struct GBA* gba, bool enabled) {
+	struct GBAMemory* memory = &gba->memory;
+	memory->ewramMask = (enabled ? GBA_SIZE_EWRAM_EXT : GBA_SIZE_EWRAM) - 1;
+	if (memory->activeRegion == GBA_REGION_EWRAM) {
+		gba->cpu->memory.activeMask = memory->ewramMask;
+	}
+}
+
+void GBAPKXWriteControl(struct GBA* gba, uint16_t value) {
+	if (value == GBA_PKX_UNLOCK_EWRAM && gba->memory.ewramMask != GBA_SIZE_EWRAM_EXT - 1) {
+		mLOG(GBA_MEM, INFO, "Extended EWRAM unlocked (16 MiB)");
+		GBAPKXSetExtendedEWRAM(gba, true);
+	}
+}
+
+uint16_t GBAPKXReadControl(struct GBA* gba) {
+	return gba->memory.ewramMask == GBA_SIZE_EWRAM_EXT - 1 ? GBA_PKX_CONTROL_EWRAM : 0;
+}
