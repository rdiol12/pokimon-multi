+void GBAPKXSetExtendedEWRAM(struct GBA* gba, bool enabled) {
+	struct GBAMemory* memory = &gba->memory;
+	memory->ewramMask = (enabled ? GBA_SIZE_EWRAM_EXT : GBA_SIZE_EWRAM) - 1;
+	if (memory->activeRegion == GBA_REGION_EWRAM) {
+		gba->cpu->memory.activeMask = memory->ewramMask;
+	}
+}
+
+void GBAPKXWriteControl(struct GBA* gba, uint16_t value) {
+	struct GBAPKXVideo* pkx = &gba->video.pkx;
+	if ((value & 0xFFF0) == GBA_PKX_SET_OVERCLOCK) {
+		int multiplier = value & 0xF;
+		if (multiplier < 1) {
+			multiplier = 1;
+		}
+		if (multiplier > GBA_PKX_MAX_OVERCLOCK) {
+			multiplier = GBA_PKX_MAX_OVERCLOCK;
+		}
+		pkx->overclock = multiplier;
+		gba->cpu->overclock = multiplier;
+		gba->cpu->overclockRemainder = 0;
+		return;
+	}
+	switch (value) {
+	case GBA_PKX_UNLOCK_EWRAM:
+		if (gba->memory.ewramMask != GBA_SIZE_EWRAM_EXT - 1) {
+			mLOG(GBA_MEM, INFO, "Extended EWRAM unlocked (16 MiB)");
+			GBAPKXSetExtendedEWRAM(gba, true);
+		}
+		break;
+	case GBA_PKX_ENABLE_OBJ:
+	case GBA_PKX_DISABLE_OBJ:
+		pkx->objEnabled = value == GBA_PKX_ENABLE_OBJ;
+		pkx->oamDirty = true;
+		gba->video.renderer->writeOAM(gba->video.renderer, 0);
+		break;
+	}
+}
+
+uint16_t GBAPKXReadControl(struct GBA* gba) {
+	uint16_t value = 0;
+	if (gba->memory.ewramMask == GBA_SIZE_EWRAM_EXT - 1) {
+		value |= GBA_PKX_CONTROL_EWRAM;
+	}
+	if (gba->video.pkx.objEnabled) {
+		value |= GBA_PKX_CONTROL_OBJ;
+	}
+	value |= (gba->cpu->overclock > 1 ? gba->cpu->overclock : 1) << 8;
+	return value;
+}
+
+// Extended video memory at 0x01000000 (region 1, unused on a real GBA):
+// sprite palettes 16..63, a 512-entry OAM and one attribute byte per entry.
+static uint8_t* _pkxPointer(struct GBA* gba, uint32_t offset, uint32_t width, int* part) {
+	struct GBAPKXVideo* pkx = &gba->video.pkx;
+	if (offset >= GBA_PKX_PALETTE_OFFSET && offset + width <= GBA_PKX_PALETTE_OFFSET + sizeof(pkx->palette)) {
+		*part = 0;
+		return (uint8_t*) pkx->palette + offset - GBA_PKX_PALETTE_OFFSET;
+	}
+	if (offset >= GBA_PKX_OAM_OFFSET && offset + width <= GBA_PKX_OAM_OFFSET + sizeof(pkx->oam)) {
+		*part = 1;
+		return (uint8_t*) pkx->oam + offset - GBA_PKX_OAM_OFFSET;
+	}
+	if (offset >= GBA_PKX_ATTR_OFFSET && offset + width <= GBA_PKX_ATTR_OFFSET + sizeof(pkx->attr)) {
+		*part = 2;
+		return pkx->attr + offset - GBA_PKX_ATTR_OFFSET;
+	}
+	// v5: extended background palettes
+	if (offset >= GBA_PKX_BG_PALETTE_OFFSET && offset + width <= GBA_PKX_BG_PALETTE_OFFSET + sizeof(pkx->bgPalette)) {
+		*part = 0;
+		return (uint8_t*) pkx->bgPalette + offset - GBA_PKX_BG_PALETTE_OFFSET;
+	}
+	// v6: right halves of wide background maps
+	if (offset >= GBA_PKX_WIDE_MAP_OFFSET && offset + width <= GBA_PKX_WIDE_MAP_OFFSET + sizeof(pkx->wideMaps)) {
+		*part = 5;
+		return (uint8_t*) pkx->wideMaps + offset - GBA_PKX_WIDE_MAP_OFFSET;
+	}
+	// v5: extra sprite tile banks
+	if (offset >= GBA_PKX_OBJ_TILE_OFFSET && offset + width <= GBA_PKX_OBJ_TILE_OFFSET + sizeof(pkx->objTiles)) {
+		*part = 4;
+		return (uint8_t*) pkx->objTiles + offset - GBA_PKX_OBJ_TILE_OFFSET;
+	}
+	// v3: battery-backed extended save
+	if (offset >= GBA_PKX_SAVE_ADDRESS && offset + width <= GBA_PKX_SAVE_ADDRESS + GBA_PKX_SAVE_SIZE
+	    && gba->memory.savedata.type != GBA_SAVEDATA_FORCE_NONE) {
+		uint8_t* save = GBASavedataPKX(&gba->memory.savedata);
+		if (save) {
+			*part = 3;
+			return save + offset - GBA_PKX_SAVE_ADDRESS;
+		}
+	}
+	return NULL;
+}
+
+uint32_t GBAPKXLoad(struct GBA* gba, uint32_t address, int width) {
+	uint32_t offset = (address & 0x00FFFFFF) & ~(uint32_t) (width - 1);
+	int part;
+	uint8_t* p = _pkxPointer(gba, offset, width, &part);
+	if (!p) {
+		mLOG(GBA_MEM, GAME_ERROR, "Bad extended video load: 0x%08X", address);
+		return 0;
+	}
+	uint32_t value = 0;
+	switch (width) {
+	case 4:
+		LOAD_32LE(value, 0, p);
+		break;
+	case 2:
+		LOAD_16LE(value, 0, p);
+		break;
+	default:
+		value = *p;
+		break;
+	}
+	return value;
+}
+
+void GBAPKXStore(struct GBA* gba, uint32_t address, uint32_t value, int width) {
+	uint32_t offset = (address & 0x00FFFFFF) & ~(uint32_t) (width - 1);
+	int part;
+	uint8_t* p = _pkxPointer(gba, offset, width, &part);
+	if (!p) {
+		mLOG(GBA_MEM, GAME_ERROR, "Bad extended video store: 0x%08X", address);
+		return;
+	}
+	switch (width) {
+	case 4:
+		STORE_32LE(value, 0, p);
+		break;
+	case 2:
+		STORE_16LE(value, 0, p);
+		break;
+	default:
+		*p = value;
+		break;
+	}
+	if (part == 3) {
+		GBASavedataPKXDirty(&gba->memory.savedata);
+	} else if (part == 0) {
+		gba->video.pkx.paletteDirty = true;
+	} else if (part == 4) {
+		// Tiles are read straight from memory while drawing
+	} else if (part == 5) {
+		gba->video.pkx.wideMapDirty = true;
+	} else {
+		gba->video.pkx.oamDirty = true;
+	}
+}
