+static inline bool GBAPKXBigRom(const struct GBAMemory* memory) {
+	return memory->romSize > GBA_SIZE_ROM0;
+}
+
+static inline uint32_t GBAPKXRomOffset(const struct GBAMemory* memory, uint32_t address, uint32_t align) {
+	if (GBAPKXBigRom(memory) && (address & 0x0F000000) >= 0x0C000000) {
+		return (GBA_SIZE_ROM0 + (address & (GBA_SIZE_ROM0 - 1))) & ~(align - 1);
+	}
+	return address & (GBA_SIZE_ROM0 - align);
