+// Overclock: scale the cycles the last instruction took, keeping the remainder
+static inline void _overclock(struct ARMCore* cpu, int32_t start) {
+	int32_t taken = cpu->cycles - start;
+	if (taken > 0) {
+		taken += cpu->overclockRemainder;
+		cpu->cycles = start + taken / cpu->overclock;
+		cpu->overclockRemainder = taken % cpu->overclock;
+	}
+}
+
 void ARMRun(struct ARMCore* cpu) {
 	while (cpu->cycles >= cpu->nextEvent) {
 		cpu->irqh.processEvents(cpu);
 	}
+	int32_t start = cpu->cycles;
 	if (cpu->executionMode == MODE_THUMB) {
 		ThumbStep(cpu);
 	} else {
 		ARMStep(cpu);
 	}
+	if (cpu->overclock > 1) {
+		_overclock(cpu, start);
+	}
 	while (cpu->cycles >= cpu->nextEvent) {
 		cpu->irqh.processEvents(cpu);
 	}
 }
 
 void ARMRunLoop(struct ARMCore* cpu) {
-	if (cpu->executionMode == MODE_THUMB) {
