+static void _pkxSplitWindowAt(struct GBAVideoSoftwareRenderer* renderer, int x) {
+	int start = 0;
+	int w;
+	for (w = 0; w < renderer->nWindows; ++w) {
+		int end = renderer->windows[w].endX;
