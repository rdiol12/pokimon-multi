+// Loads the extended save from the file the first time it's used.
+uint8_t* GBASavedataPKX(struct GBASavedata* savedata) {
+	if (savedata->pkx) {
+		return savedata->pkx;
+	}
+	savedata->pkx = calloc(1, GBA_PKX_SAVE_SIZE);
+	if (!savedata->pkx) {
+		return NULL;
+	}
+	if (savedata->vf && savedata->vf->size(savedata->vf) > GBA_PKX_SAVE_OFFSET) {
+		savedata->vf->seek(savedata->vf, GBA_PKX_SAVE_OFFSET, SEEK_SET);
+		savedata->vf->read(savedata->vf, savedata->pkx, GBA_PKX_SAVE_SIZE);
+		savedata->pkxUsed = true;
+	}
+	return savedata->pkx;
