+static void _pkxFlush(struct GBASavedata* savedata) {
+	savedata->pkxDirty = 0;
+	if (!savedata->vf || !savedata->pkx || !(savedata->mapMode & MAP_WRITE) || savedata->type != GBA_SAVEDATA_FLASH1M) {
+		return;
+	}
+	size_t size = GBASavedataSize(savedata);
+	int bank = 0;
+	bool remap = false;
+	if (savedata->vf->size(savedata->vf) < GBA_PKX_SAVE_OFFSET + GBA_PKX_SAVE_SIZE && savedata->data) {
+		// Writing past the end of the file can invalidate the file mapping
+		bank = savedata->currentBank == &savedata->data[0x10000];
+		savedata->vf->unmap(savedata->vf, savedata->data, size);
+		savedata->data = NULL;
+		remap = true;
+	}
+	savedata->vf->seek(savedata->vf, GBA_PKX_SAVE_OFFSET, SEEK_SET);
+	if (savedata->vf->write(savedata->vf, savedata->pkx, GBA_PKX_SAVE_SIZE) != GBA_PKX_SAVE_SIZE) {
+		mLOG(GBA_SAVE, WARN, "Extended save failed to write");
+	}
+	if (remap) {
+		savedata->data = savedata->vf->map(savedata->vf, size, MAP_WRITE);
+		savedata->currentBank = &savedata->data[bank << 16];
+	}
+	mLOG(GBA_SAVE, INFO, "Extended save synced");
+}
